#!/usr/bin/env bash
set -euo pipefail
# In the Hub checkout this runs in its toolchain container (HubTools/hub-run); elsewhere it runs here.
hub_run="$(dirname "$0")/../../../HubTools/hub-run"
[[ -n "${HUB_TOOLCHAIN:-}" || ! -x "$hub_run" ]] || exec "$hub_run" bash "$0" "$@"

cd "$(dirname "$0")/.."
# The QUIC tests need the optional aioquic dependency (the quic extra)
uv run --extra dev --extra quic pytest tests/unit -q
uv run --extra dev --extra quic pytest tests/quic -q
uv run --extra dev --extra quic pytest tests/interop -q
